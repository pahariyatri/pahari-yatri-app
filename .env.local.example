# ── Discord Webhook (required for form notifications) ──────────────────────────
# Create a webhook in your Discord server: Server Settings → Integrations → Webhooks
# Copy the webhook URL and paste it here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Analytics (optional) ───────────────────────────────────────────────────────
# Google Analytics 4: get your Measurement ID (format G-XXXXXXXXXX) from
# Google Analytics → Admin → Data Streams. Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Umami (alternative): get your website ID from app.umami.is
NEXT_UMAMI_ID=

# ── EmailJS (used on /apply page) ──────────────────────────────────────────────
# These are already hardcoded in app/apply/page.tsx — move them here for security
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ADMIN=
# EMAILJS_TEMPLATE_USER=
# EMAILJS_PUBLIC_KEY=

# ── Instagram (optional — pulls live reels onto /films) ─────────────────────────
# See docs/instagram-integration.md for the full setup walkthrough.
# Facebook Graph API user token (Facebook Login for Business flow), valid ~60 days.
INSTAGRAM_ACCESS_TOKEN=
# The Instagram Business Account ID linked to the Facebook Page (stable, doesn't expire).
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── YouTube (optional — pulls latest uploads onto /films) ───────────────────────
# See docs/youtube-integration.md for the full setup walkthrough.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
